{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/instructions/candor.md",
    "~/.config/opencode/instructions/environment.md",
    "~/.config/opencode/instructions/shell-strategy.md",
    "~/.config/opencode/instructions/vibeguard.md",
    "~/.config/opencode/instructions/source-code-fetch.md",
    "~/.config/opencode/instructions/docs-first.md",
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "file *": "allow",
      "find *": "allow",
      "git log *": "allow",
      "ls *": "allow",
    },
  },
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "general",
  "subagent_depth": 2,
  "agent": {
    "build": {
      "model": "deepseek/deepseek-v4-flash",
    },
    "check-human-code": {
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "skill": {
          "coding-standards": "deny",
        },
      },
    },
    "explore": {
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "skill": {
          "coding-standards": "deny",
        },
      },
    },
    "general": {
      "model": "deepseek/deepseek-v4-flash",
      "mode": "primary",
      "permission": {
        "skill": {
          "coding-standards": "deny",
        },
      },
    },
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "mode": "subagent",
    },
  },
  "mcp": {
    "Grep MCP": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"],
  },
  "enabled_providers": ["opencode", "deepseek"],
  "plugin": ["opencode-vibeguard"],
}
