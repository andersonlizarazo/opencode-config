{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "instructions/candor.md",
    "instructions/environment.md",
    "instructions/shell-strategy.md",
    "instructions/vibeguard.md",
    "instructions/source-code-fetch.md",
    "instructions/docs-first.md",
  ],
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "general",
  "subagent_depth": 2,
  "agent": {
    "build": {
      "model": "deepseek/deepseek-v4-flash",
    },
    "check-human-code": {
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "skill": {
          "coding-standards": "deny"
        }
      },
    },
    "explore": {
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "skill": {
          "coding-standards": "deny"
        }
      },
    },
    "general": {
      "model": "deepseek/deepseek-v4-flash",
      "mode": "primary",
      "permission": {
        "skill": {
          "coding-standards": "deny"
        }
      },
    },
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "mode": "subagent",
    },
  },
  "mcp": {
    "Grep MCP": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"],
  },
  "enabled_providers": ["deepseek"],
  "plugin": [
    "cc-safety-net",
    "opencode-vibeguard",
  ],
}
